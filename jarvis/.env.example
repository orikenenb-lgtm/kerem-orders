# ----------------------------------------------------------------------
# jarvis/.env.example  —  copy to jarvis/.env and fill in.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a && python3 server.py
#
# .env is gitignored. Never commit real keys.
# ----------------------------------------------------------------------

# --- The voice (Fish Audio) -------------------------------------------
# Key: https://fish.audio  →  account  →  API keys.
# Leave empty and the dashboard still works, it just won't speak.
FISH_AUDIO_API_KEY=

# The British butler voice. Open a voice in the Fish Audio Voice Library
# and copy the id out of its URL: fish.audio/m/<THIS_BIT>/
# Search the library for "butler" or "British male". Empty = default voice.
FISH_AUDIO_REFERENCE_ID=

# s2.1-pro-free was free through the end of July 2026 — check whether it
# still resolves before relying on it, and switch to a paid model string
# (~$15 per million characters) if it doesn't.
FISH_AUDIO_MODEL=s2.1-pro-free

# --- The brain (Claude Code) ------------------------------------------
# Path to the CLI if it isn't on your PATH.
JARVIS_CLAUDE_BIN=claude

# Which folder Claude runs in — this decides which CLAUDE.md, skills and
# MCP servers are in scope. Point it at the project you want Jarvis to
# know about. Defaults to the jarvis/ folder itself.
# JARVIS_CLAUDE_CWD=/Users/you/code/kerem-orders

# Seconds before a question is abandoned.
JARVIS_CLAUDE_TIMEOUT=120

# Extra flags passed to `claude -p`, space separated. Useful one:
#   --allowed-tools "Read Grep Glob"      (read-only Jarvis)
JARVIS_CLAUDE_ARGS=

# --- The server -------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
