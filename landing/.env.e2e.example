# E2E (Playwright) environment — STAGING Supabase ONLY.
#
# Copy to `.env.e2e` and source it before `npm run e2e`, or export these two
# vars in your shell / CI. The Playwright webServer also falls back to these
# exact staging values when the vars are unset (see playwright.config.ts), so
# the harness runs out of the box.
#
# NEVER point the E2E harness at production Supabase. These are read-only smoke
# tests, but the whole point is to exercise STAGING.
#
# The app reads these names in landing/lib/supabaseClient.ts.

# Staging Supabase REST/Realtime API URL.
NEXT_PUBLIC_SUPABASE_URL=https://ahptrtlnrpmevlpgqeac.supabase.co

# Staging publishable (anon) key. This is a PUBLIC client key: it is meant to
# ship to the browser and all access is enforced by Postgres Row-Level-Security.
# Safe to commit as an example value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_OUA6ExlgitE1YOKkxjj4wQ_UlWuxZRb
